generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  ORDERED
  RECEIVED
  UNDER_REVIEW
  PACKAGING
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum SupportSenderRole {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String   @default("")
  phone        String   @default("")
  passwordHash String
  role         UserRole @default(CUSTOMER)
  passwordResetCodeHash      String?
  passwordResetCodeExpiresAt DateTime?
  passwordResetCodeSentAt    DateTime?
  orders       Order[]
  supportMessages SupportMessage[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderRole SupportSenderRole @default(CUSTOMER)
  adminId   String?
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([createdAt])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         OrderStatus @default(ORDERED)

  receivedAt       DateTime?
  underReviewAt    DateTime?
  packagingAt      DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?

  packagingEtaMinutes Int?
  deliveryEtaMinutes  Int?

  transportMethod      String?
  transportPlateNumber String?

  items          Json
  totalsByCurrency Json
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String
  price         Int
  currency      String   @default("USD")
  category      String
  categoryId    String?
  categoryRel   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inStock       Boolean  @default(true)
  isNew         Boolean  @default(false)
  productScroll Boolean  @default(false)
  discount      Int?
  sizes         String[]
  features      String[]
  imageUrls     String[]
  imagePublicIds String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

enum AdvertMediaType {
  IMAGE
  VIDEO
}

model Advert {
  id            String          @id @default(cuid())
  title         String
  productLink   String
  mediaType     AdvertMediaType @default(IMAGE)
  imageUrl      String?
  imagePublicId String?
  videoUrl      String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model ShowroomVideo {
  id          String   @id @default(cuid())
  title       String
  productLink String
  videoUrl    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model UiConfig {
  id            Int      @id
  showroomHidden Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
